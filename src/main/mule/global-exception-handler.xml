<?xml version="1.0" encoding="UTF-8"?>

<mule 
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
 http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd">
<error-handler name="ApiKit_Error_Handler" doc:id="22f4bc4f-3c50-4e31-b495-727ac246b1a7" >
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="986ed727-3938-4527-ae18-fdf805578edc" type="APIKIT:BAD_REQUEST" >
			<set-variable value="400" doc:name="httpStatus" doc:id="38c3adbc-d115-43e6-98c8-beb54224edb6" variableName="httpStatus" />
			<flow-ref doc:name="basic-global-exception-handler-flow" doc:id="cda56092-d373-4b09-a729-a7ac9aadb3c6" name="basic-global-exception-handler-flow" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="8b3c8787-79f7-4270-8af8-438f14eff82c" type="APIKIT:NOT_FOUND" >
			<set-variable value="404" doc:name="httpStatus" doc:id="1ead7f07-d393-4b63-b7bd-95ead16a2f4a" variableName="httpStatus" />
			<flow-ref doc:name="basic-global-exception-handler-flow" doc:id="8030ac02-38b9-4ae7-9a43-898e57cfa13b" name="basic-global-exception-handler-flow" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="65cf1ba9-f577-463e-b7c7-d883eddc20c9" type="APIKIT:METHOD_NOT_ALLOWED" >
			<set-variable value="405" doc:name="httpStatus" doc:id="61d2e010-e069-494d-857b-d1a3b926d675" variableName="httpStatus" />
